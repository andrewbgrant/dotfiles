background = "#121314"
# background = "#1a1a17"
background-blur = macos-glass-regular
background-opacity = 0.98

# font-family = Liga SFMono Nerd Font
font-size=16
cursor-style-blink = false
cursor-style = bar
bell-features = no-system,no-audio,no-attention,no-title,no-border

keybind = cmd+a=ignore
keybind = cmd+enter=unbind
keybind = cmd+t=text:\x1bt
keybind = cmd+shift+]=unbind
keybind = cmd+shift+[=unbind
keybind = cmd+1=text:\x1b1
keybind = cmd+2=text:\x1b2
keybind = cmd+3=text:\x1b3
keybind = cmd+4=text:\x1b4
keybind = cmd+5=text:\x1b5
keybind = cmd+6=text:\x1b6
keybind = cmd+7=text:\x1b7
keybind = cmd+8=text:\x1b8
keybind = cmd+9=text:\x1b9
keybind = cmd+digit_1=text:\x1b1
keybind = cmd+digit_2=text:\x1b2
keybind = cmd+digit_3=text:\x1b3
keybind = cmd+digit_4=text:\x1b4
keybind = cmd+digit_5=text:\x1b5
keybind = cmd+digit_6=text:\x1b6
keybind = cmd+digit_7=text:\x1b7
keybind = cmd+digit_8=text:\x1b8
keybind = cmd+digit_9=text:\x1b9
keybind = cmd+d=unbind
keybind = cmd+shift+d=unbind
keybind = cmd+k=ignore
keybind = cmd+s=text:\x1bs
keybind = cmd+n=text:\x1bn
keybind = cmd+p=text:\x1bp
keybind = cmd+w=text:\x1bw
keybind = cmd+backspace=text:\x15
keybind = alt+backspace=text:\x17

copy-on-select = clipboard
macos-window-shadow = true
mouse-hide-while-typing = true

clipboard-paste-protection = true
shell-integration = zsh
shell-integration-features = ssh-env,ssh-terminfo
keybind = delete=csi:3~
keybind = backspace=text:\x7f

macos-titlebar-style = tabs
macos-titlebar-proxy-icon = hidden
title = ghostty 
macos-icon= blueprint
auto-update-channel = tip

