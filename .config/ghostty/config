background = "#1a1a17"
#background = "#222227"
#background = "#1C274D"
#background = "#3b404f"
background-blur-radius = 35
background-opacity = 0.80

# Liga SFMono Nerd Font
# font-family = FiraCode Nerd Font
# window-title-font-family = Liga SFMono Nerd Font
font-size=14
cursor-style-blink = false
cursor-style = block

# Disabled: interferes with pi's native Shift+Enter handling
# keybind = shift+enter=text:\x1b\r
keybind = cmd+enter=unbind
keybind = cmd+t=unbind
keybind = cmd+shift+]=unbind
keybind = cmd+shift+[=unbind
keybind = cmd+1=unbind
keybind = cmd+2=unbind
keybind = cmd+3=unbind
keybind = cmd+4=unbind
keybind = cmd+5=unbind
keybind = cmd+6=unbind
keybind = cmd+7=unbind
keybind = cmd+8=unbind
keybind = cmd+9=unbind
keybind = cmd+d=unbind
keybind = cmd+shift+d=unbind
keybind = cmd+s=unbind
keybind = cmd+n=unbind
keybind = cmd+p=unbind
keybind = cmd+x=unbind
keybind = cmd+s=text:\x1bs
keybind = cmd+n=text:\x1bn
keybind = cmd+p=text:\x1bp
keybind = cmd+x=text:\x1bx

copy-on-select = clipboard
macos-window-shadow = false
mouse-hide-while-typing = true

clipboard-paste-protection = false
shell-integration = zsh
keybind = delete=csi:3~
keybind = backspace=text:\x7f

macos-titlebar-proxy-icon = hidden
title = ghostty 
